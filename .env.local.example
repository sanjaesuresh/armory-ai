# Supabase public vars — copy this file to .env.local and fill in your project values.
# These are safe to expose in the browser (NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-key-here

# ─── Service-role key (scripts only — NEVER shipped to the browser) ───────────
# Used ONLY by scripts/export-report.ts (and similar server-side scripts).
# This key bypasses Row Level Security, so treat it like a root database password.
# IMPORTANT: never reference SUPABASE_SERVICE_ROLE_KEY in app code or any
# Next.js module — it must never be bundled or sent to a client.
# Get it from: Supabase dashboard → Project Settings → API → service_role key.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Public URL (used in sitemap, robots.txt, and OG meta tags) ──────────────
# Set to your production domain. Trailing slash is stripped automatically.
# Without this, builds emit a warning and sitemap/robots/OG fall back to localhost.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com
